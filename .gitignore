# Dependencies
node_modules/

# Frontend build output
dist/
*.tsbuildinfo

# Rust / Tauri build output
src-tauri/target/
# Auto-generated by tauri-build at compile time (schemas for the capabilities
# editor); regenerated on every build, not meant to be committed.
src-tauri/gen/
src-tauri/Cargo.lock.bak

# Tauri bundler output
release/
src-tauri/target/release/bundle/

# Generated app-icon resources (from assets/ClovaSweep_Icon.png via
# `npm run icons`). The committed src-tauri/icons/ set is checked in so
# CI/packaging need no image toolchain; ignore stray scratch exports only.
resources/icon-cache/

# Coverage
coverage/

# Logs
*.log
npm-debug.log*

# OS junk
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Env / secrets
.env
.env.*
*.p12
*.mobileprovision
