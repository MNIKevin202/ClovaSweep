{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClovaSweep",
  "version": "1.0.0",
  "identifier": "com.clova.clovasweep",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:vite",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ClovaSweep",
        "width": 1060,
        "height": 730,
        "minWidth": 900,
        "minHeight": 620,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#17090f",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Clova Suite",
    "category": "Utility",
    "shortDescription": "Instantly sweep away running apps while keeping the ones you protect.",
    "longDescription": "ClovaSweep is a small cross-platform desktop utility for macOS and Windows that lets you instantly close nearly all currently running applications while preserving apps you have explicitly protected. A member of the Clova Suite.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.mac.plist",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  }
}
